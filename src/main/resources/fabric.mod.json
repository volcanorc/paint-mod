{
  "schemaVersion": 1,
  "id": "artmap_color_assistant",
  "version": "${version}",
  "name": "ArtMapColorAssistant",
  "description": "Client-side helper for manually painting ArtMap canvases by switching held color items.",
  "authors": [
    "Codex"
  ],
  "contact": {},
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.artmapcolorassistant.ArtMapColorAssistantClient"
    ]
  },
  "mixins": [
    "artmap_color_assistant.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${minimum_loader_version}",
    "minecraft": "${minecraft_version}",
    "fabric-api": ">=${minimum_fabric_version}",
    "java": ">=21"
  }
}
